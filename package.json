{
  "name": "crystelf-plugin",
  "version": "2.2.0",
  "description": "适配crystelf-core的Yunzai插件",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "check:encoding": "node ./scripts/check-encoding.mjs",
    "check:structure": "node ./scripts/check-structure.mjs",
    "check:config": "node ./scripts/check-config-consistency.mjs",
    "check:js": "node ./scripts/check-webconsole-js.mjs",
    "check:functional": "node ./scripts/check-functional-smoke.mjs",
    "check:render": "node ./scripts/check-render-smoke.mjs",
    "check:webconsole": "node ./scripts/check-webconsole-smoke.mjs",
    "check:webconsole:visual": "node ./scripts/check-webconsole-visual.mjs",
    "check:webconsole:image": "node ./scripts/check-api-image-runtime-visual.mjs",
    "check:webconsole:e2e": "node ./scripts/check-webconsole-e2e.mjs",
    "check:webconsole:mobile": "node ./scripts/check-webconsole-e2e.mjs --mobile-only",
    "check:quick": "npm run check:encoding && npm run check:structure && npm run check:config && npm run check:js",
    "check": "npm run check:quick && npm run check:functional && npm run check:render && npm run check:webconsole"
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/nuesurwan/crystelf-plugin.git"
  },
  "keywords": [
    "TRSS-Yunzai",
    "crystelf-plugin"
  ],
  "author": "Jerry",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.6",
    "chalk": "^5.6.2",
    "form-data": "^4.0.5",
    "highlight.js": "^11.11.1",
    "lodash.merge": "^4.6.2",
    "markdown-it": "^14.1.1",
    "node-schedule": "^2.1.1",
    "oicq": "^2.3.1",
    "openai": "^4.104.0",
    "opencode-ai": "1.18.4",
    "pinyin-pro": "^3.28.0",
    "puppeteer": "^24.39.0",
    "rss-parser": "^3.13.0"
  },
  "imports": {},
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "eslint": "^8.57.1",
    "globals": "^16.0.0",
    "prettier": "^3.5.3"
  }
}
