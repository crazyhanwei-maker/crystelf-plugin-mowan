{
  "enabled": true,
  "name": "country",
  "description": "REST Countries 国家信息工具，适合查询国家、首都、货币、语言、人口、区域、时区、国旗和国家代码。",
  "allowedHosts": [
    "restcountries.com"
  ],
  "timeoutMs": 10000,
  "tools": [
    {
      "name": "search_country",
      "description": "按国家名称查询国家信息。必须提供 name；适合问某国首都、货币、语言、人口、时区和国旗。",
      "parameters": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "国家英文名或通用名称，例如 Japan、China、United States"
          },
          "fullText": {
            "type": "boolean",
            "description": "是否精确匹配完整国家名，默认不传"
          }
        },
        "required": [
          "name"
        ]
      },
      "request": {
        "method": "GET",
        "url": "https://restcountries.com/v3.1/name/{{name}}",
        "query": {
          "fullText": "{{fullText}}",
          "fields": "name,capital,currencies,languages,flag,flags,population,region,subregion,timezones,cca2,cca3,area,maps"
        },
        "headers": {
          "Accept": "application/json"
        }
      },
      "response": {
        "maxLength": 2800
      },
      "stopOnFailure": true
    },
    {
      "name": "get_country_by_code",
      "description": "按 ISO 国家代码查询国家信息。必须提供 code，例如 CN、JP、US、GB。",
      "parameters": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "ISO 3166 国家代码，例如 CN、JP、US、GB"
          }
        },
        "required": [
          "code"
        ]
      },
      "request": {
        "method": "GET",
        "url": "https://restcountries.com/v3.1/alpha/{{code}}",
        "query": {
          "fields": "name,capital,currencies,languages,flag,flags,population,region,subregion,timezones,cca2,cca3,area,maps"
        },
        "headers": {
          "Accept": "application/json"
        }
      },
      "response": {
        "maxLength": 2600
      },
      "stopOnFailure": true
    }
  ]
}
