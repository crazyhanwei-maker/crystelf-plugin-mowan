{
  "enabled": false,
  "name": "social",
  "description": "社交与开发者资料工具，包含 B站视频/直播/用户信息与 GitHub 仓库信息",
  "allowedHosts": [
    "uapis.cn"
  ],
  "timeoutMs": 12000,
  "tools": [
    {
      "name": "github_repo_info",
      "description": "查询 GitHub 仓库信息。必须提供 repo，格式为 owner/repo。",
      "parameters": {
        "type": "object",
        "properties": {
          "repo": {
            "type": "string",
            "description": "GitHub 仓库路径，格式 owner/repo，例如 openai/openai-node"
          }
        },
        "required": [
          "repo"
        ]
      },
      "request": {
        "method": "GET",
        "url": "https://uapis.cn/api/v1/github/repo",
        "query": {
          "repo": "{{repo}}"
        },
        "headers": {
          "Accept": "application/json"
        }
      },
      "response": {
        "pick": [
          "full_name",
          "description",
          "homepage",
          "language",
          "topics",
          "stargazers",
          "forks",
          "open_issues",
          "latest_release"
        ],
        "maxLength": 2400
      },
      "stopOnFailure": true
    },
    {
      "name": "bilibili_videoinfo",
      "description": "查询 B站视频详细信息。必须提供 bvid。",
      "parameters": {
        "type": "object",
        "properties": {
          "bvid": {
            "type": "string",
            "description": "B站视频 BV 号，例如 BV1xx411c7mD"
          }
        },
        "required": [
          "bvid"
        ]
      },
      "request": {
        "method": "GET",
        "url": "https://uapis.cn/api/v1/social/bilibili/videoinfo",
        "query": {
          "bvid": "{{bvid}}"
        },
        "headers": {
          "Accept": "application/json"
        }
      },
      "response": {
        "pick": [
          "title",
          "pic",
          "owner",
          "stat",
          "desc",
          "pubdate",
          "tname"
        ],
        "maxLength": 2800
      },
      "stopOnFailure": true
    },
    {
      "name": "bilibili_liveroom",
      "description": "查询 B站直播间信息。必须提供 room_id。",
      "parameters": {
        "type": "object",
        "properties": {
          "room_id": {
            "type": "string",
            "description": "B站直播间号"
          }
        },
        "required": [
          "room_id"
        ]
      },
      "request": {
        "method": "GET",
        "url": "https://uapis.cn/api/v1/social/bilibili/liveroom",
        "query": {
          "room_id": "{{room_id}}"
        },
        "headers": {
          "Accept": "application/json"
        }
      },
      "response": {
        "pick": [
          "room_id",
          "live_status",
          "title",
          "online",
          "area_name",
          "user_cover"
        ],
        "maxLength": 2200
      },
      "stopOnFailure": true
    },
    {
      "name": "bilibili_userinfo",
      "description": "查询 B站用户信息。必须提供 uid。",
      "parameters": {
        "type": "object",
        "properties": {
          "uid": {
            "type": "string",
            "description": "B站用户 UID"
          }
        },
        "required": [
          "uid"
        ]
      },
      "request": {
        "method": "GET",
        "url": "https://uapis.cn/api/v1/social/bilibili/userinfo",
        "query": {
          "uid": "{{uid}}"
        },
        "headers": {
          "Accept": "application/json"
        }
      },
      "response": {
        "pick": [
          "name",
          "face",
          "sign",
          "level",
          "follower",
          "archive_count"
        ],
        "maxLength": 2200
      },
      "stopOnFailure": true
    }
  ]
}
